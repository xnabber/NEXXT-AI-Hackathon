# Local server-only configuration. Copy this file to .env and fill in your key.
# .env is ignored by Git. Never prefix secrets with VITE_.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
# npm run dev, npm start, and npm run bedrock:test load .env automatically.
# Existing environment variables take precedence over values in .env.
