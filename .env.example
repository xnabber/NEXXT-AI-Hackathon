# Node 20+; .env is ignored by Git. No provider configured means offline mode.
HOST=127.0.0.1
PORT=5173
DEMO_MODE=1
# Choices: offline, anthropic, openai, bedrock (optional compatibility adapter).
AGENT_PROVIDER=offline
# Specialist supervisor; set 0 to use the original single-agent loop.
AGENT_ORCHESTRATION=1
AGENT_MODEL=
AGENT_ANTHROPIC_API_KEY=
AGENT_OPENAI_API_KEY=
AGENT_OPENAI_BASE_URL=https://api.openai.com/v1
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
AGENT_TIMEOUT_MS=12000
AGENT_TOKEN_BUDGET=40000
# Optional explicit pricing assumptions; blank means unknown, not free.
AGENT_INPUT_USD_PER_MILLION=
AGENT_OUTPUT_USD_PER_MILLION=
# Required for admin outside demo mode. Supply locally; never commit values.
ADMIN_TOKEN=
